<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!-- Self-update: check GitHub Releases + download the new APK. Wear OS
         routes this transparently through the paired phone's connection
         even on watches with no LTE/Wi-Fi of their own. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update: install the downloaded APK over this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Claude Remote"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Sideloaded, no Play-installed phone counterpart to validate against —
             without this some Wear launchers hide/refuse the app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="com.clauderemote.wear.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles the PackageInstaller session result (self-update). -->
        <receiver
            android:name="com.clauderemote.wear.InstallResultReceiver"
            android:exported="false" />

        <!-- Receives the phone's /sessions Data Layer pushes (WearSync) and
             the pushed-APK channel transfer (WearApkPusher). -->
        <service
            android:name="com.clauderemote.wear.WearDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/" />
            </intent-filter>
        </service>

    </application>
</manifest>
