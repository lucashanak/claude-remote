<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!-- Self-update: check GitHub Releases + download the new APK. Wear OS
         routes this transparently through the paired phone's connection
         even on watches with no LTE/Wi-Fi of their own. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update: install the downloaded APK over this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Wakes the screen for the install-confirm notification if it's
         asleep/ambient — a sideloaded app is never subject to Google Play's
         installer-side auto-revocation of this permission (see
         InstallResultReceiver's kdoc), but still gated at runtime behind
         canUseFullScreenIntent() in case an OEM skin diverges. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Claude Remote"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Sideloaded, no Play-installed phone counterpart to validate against —
             without this some Wear launchers hide/refuse the app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="com.clauderemote.wear.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles the PackageInstaller session result (self-update). -->
        <receiver
            android:name="com.clauderemote.wear.InstallResultReceiver"
            android:exported="false" />

        <!-- Trampoline launched via the install-confirm notification's
             full-screen intent — wakes the screen, hands off to the real
             confirmation Intent, finishes. Never shows its own UI, so a
             translucent no-display theme avoids a visible flash. -->
        <activity
            android:name="com.clauderemote.wear.WakeAndConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Wraps the self-update download in a foreground service — Wear
             OS's background-execution limits silently suspended the plain
             background download once the watch went to ambient/screen-off. -->
        <service
            android:name="com.clauderemote.wear.WearUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives the phone's /sessions Data Layer pushes (WearSync). -->
        <service
            android:name="com.clauderemote.wear.WearDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <!-- Scoped to this app's own path, not a "/" wildcard — a
                     wildcard wakes this process for ANY Data Layer traffic
                     on the device, not just its own. -->
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sessions" />
            </intent-filter>
        </service>

    </application>
</manifest>
