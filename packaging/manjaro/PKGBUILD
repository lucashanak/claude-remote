# Maintainer: Lukas Hanak <hanakl@nekrachni.cz>
pkgname=claude-remote
pkgver=1.0.0
pkgrel=1
pkgdesc="Claude Code Remote Controller"
arch=('x86_64')
url="https://github.com/lucashanak/claude-remote"
license=('MIT')

# Runtime dependencies for a Compose/Skiko desktop app on Arch/Manjaro:
#   fontconfig, freetype2 — text rendering (Skiko/Skia requires these)
#   mesa                 — OpenGL used by the Skia renderer
#   libx11, libxext, libxrender — X11 windowing
#   hicolor-icon-theme   — icon theme integration
# The JVM is bundled inside the app-image, so no java/jre dependency.
depends=(
    'fontconfig'
    'freetype2'
    'mesa'
    'libx11'
    'libxext'
    'libxrender'
    'hicolor-icon-theme'
)

# All three sources are local files that must sit next to this PKGBUILD before
# `makepkg`:
#   - claude-remote-linux-x64.tar.gz  → produced by GHA build-linux (or scripts/build-linux.sh)
#   - claude-remote.desktop           → shipped here in packaging/manjaro/
#   - icon.png                        → copy from desktopApp/src/main/resources/icon.png
# integrity is skipped (SKIP) because the tarball is a fresh per-build artifact.
source=("claude-remote-linux-x64.tar.gz"
        "claude-remote.desktop"
        "icon.png")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    # The tarball extracts to a top-level "Claude Remote" directory
    # (Compose packageName). Install its contents to /opt/claude-remote.
    install -dm755 "${pkgdir}/opt/${pkgname}"
    cp -a "${srcdir}/Claude Remote/." "${pkgdir}/opt/${pkgname}/"

    # Launcher symlink → /usr/bin/claude-remote
    install -dm755 "${pkgdir}/usr/bin"
    ln -s "/opt/${pkgname}/bin/Claude Remote" "${pkgdir}/usr/bin/${pkgname}"

    # Desktop entry + icon
    install -Dm644 "${srcdir}/claude-remote.desktop" \
        "${pkgdir}/usr/share/applications/${pkgname}.desktop"
    install -Dm644 "${srcdir}/icon.png" \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
}
